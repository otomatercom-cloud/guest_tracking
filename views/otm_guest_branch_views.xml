<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_guest_branch_list" model="ir.ui.view">
        <field name="name">otm.guest.branch.list</field>
        <field name="model">otm.guest.branch</field>
        <field name="arch" type="xml">
            <list string="Branches">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="visit_count"/>
                <field name="qr_code_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_otm_guest_branch_form" model="ir.ui.view">
        <field name="name">otm.guest.branch.form</field>
        <field name="model">otm.guest.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_qr_codes" type="object" class="oe_stat_button" icon="fa-qrcode">
                            <field name="qr_code_count" widget="statinfo" string="QR Codes"/>
                        </button>
                        <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kochi Branch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_otm_guest_branch_search" model="ir.ui.view">
        <field name="name">otm.guest.branch.search</field>
        <field name="model">otm.guest.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_otm_guest_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">otm.guest.branch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first reception branch.</p></field>
    </record>
</odoo>
