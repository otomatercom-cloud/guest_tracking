<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_guest_course_list" model="ir.ui.view">
        <field name="name">otm.guest.course.list</field>
        <field name="model">otm.guest.course</field>
        <field name="arch" type="xml">
            <list string="Courses" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_otm_guest_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">otm.guest.course</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Add the courses visitors can enquire/admit into.</p></field>
    </record>
</odoo>
